	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<configuration>
					<!-- 教育行业模块是可启动应用，覆盖父工程的默认跳过配置。 -->
					<skip>false</skip>
					<mainClass>com.chronos.ChronosEducationApplication</mainClass>
				</configuration>
			</plugin>
		</plugins>
