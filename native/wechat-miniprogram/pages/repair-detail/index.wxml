<view class="page" wx:if="{{order}}"><view class="card"><view class="card-title">{{order.title}}</view><view class="status">{{order.statusLabel}}</view><view class="line">报修单号：{{order.orderNo}}</view><view class="line">位置：{{order.location}}</view><view class="line">故障描述：{{order.description}}</view><view class="line">维修人员：{{order.technicianName||'等待派单'}}</view><view class="line">维修结果：{{order.completionNote||'-'}}</view></view><button wx:if="{{assigned&&order.status==='DISPATCHED'}}" class="primary" data-action="accept" bindtap="action">接单</button><button wx:if="{{assigned&&(order.status==='ACCEPTED'||order.status==='WAITING_MATERIAL')}}" class="primary" data-action="start" bindtap="action">开始维修</button><view wx:if="{{assigned&&materials.length&&(order.status==='ACCEPTED'||order.status==='IN_PROGRESS'||order.status==='WAITING_MATERIAL')}}" class="card"><view class="card-title">申请维修物料</view><picker range="{{materials}}" range-key="label" value="{{materialIndex}}" bindchange="materialChange"><view class="picker">{{materials[materialIndex].label}}</view></picker><input type="digit" value="{{materialQuantity}}" bindinput="materialQuantity"/><button class="secondary" bindtap="requestMaterial">提交物料申请</button></view><view wx:if="{{assigned&&(order.status==='IN_PROGRESS'||order.status==='WAITING_MATERIAL')}}" class="card"><textarea placeholder="填写维修结果" bindinput="input"/><button class="secondary" bindtap="chooseCompletion">选择完工照片</button><image wx:if="{{completionPhoto}}" src="{{completionPhoto}}" class="photo" mode="aspectFill"/><button class="primary" loading="{{submitting}}" bindtap="complete">提交完工</button></view><button wx:if="{{!assigned&&order.status==='COMPLETED'}}" class="primary" bindtap="close">确认维修并关闭</button></view>
