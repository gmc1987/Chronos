.hero-kicker { color: rgba(255,255,255,.72); font-size: 23rpx; letter-spacing: 3rpx; }
.schedule-scroll { width: 100%; white-space: nowrap; }
.schedule-row { display: inline-flex; gap: 16rpx; padding-bottom: 6rpx; }
.schedule-card { width: 290rpx; padding: 26rpx; border-radius: 26rpx; background: #fff; box-sizing: border-box; }
.schedule-course { overflow: hidden; font-size: 29rpx; font-weight: 650; text-overflow: ellipsis; }
.schedule-meta { overflow: hidden; margin-top: 10rpx; color: #71808a; font-size: 23rpx; text-overflow: ellipsis; }
.service-card { min-height: 270rpx; }
.service-icon { display: flex; align-items: center; justify-content: center; width: 68rpx; height: 68rpx; margin-bottom: 18rpx; border-radius: 22rpx; color: #087b68; background: #ebf7f4; font-weight: 700; }
