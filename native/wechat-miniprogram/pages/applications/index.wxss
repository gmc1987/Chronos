.compact-hero { padding-top: 30rpx; padding-bottom: 30rpx; }
.app-card { min-height: 250rpx; }
.app-icon { display:flex; align-items:center; justify-content:center; width:72rpx; height:72rpx; margin-bottom:18rpx; border-radius:23rpx; color:#087b68; background:#ebf7f4; font-weight:700; }
