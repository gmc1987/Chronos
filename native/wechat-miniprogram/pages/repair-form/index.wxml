<view class="page"><view class="card form"><input placeholder="故障标题" data-key="title" bindinput="input"/><picker range="{{categories}}" value="{{categoryIndex}}" bindchange="category"><view class="picker">故障分类：{{categories[categoryIndex]}}</view></picker><input placeholder="故障位置" data-key="location" bindinput="input"/><textarea placeholder="详细描述" data-key="description" bindinput="input"/><input placeholder="联系人" data-key="contactName" bindinput="input"/><input placeholder="联系电话" type="number" data-key="contactPhone" bindinput="input"/><button class="secondary" bindtap="choose">拍照或选择照片（{{photos.length}}）</button><view class="photos"><image wx:for="{{photos}}" wx:key="*this" src="{{item}}" mode="aspectFill"/></view></view><button class="primary" loading="{{submitting}}" bindtap="submit">提交报修</button></view>
