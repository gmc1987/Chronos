<view class="page"><view class="hero compact-hero"><view class="hero-title">故障报修</view><view class="hero-subtitle">校园设施故障拍照报修与进度跟踪</view></view><view class="segment"><view class="segment-item {{!assigned?'active':''}}" data-assigned="false" bindtap="switchMode">我的报修</view><view class="segment-item {{assigned?'active':''}}" data-assigned="true" bindtap="switchMode">维修工单</view></view><button wx:if="{{!assigned}}" class="primary" bindtap="create">我要报修</button><view wx:if="{{loading}}" class="loading">正在加载…</view><view wx:elif="{{!rows.length}}" class="empty">暂无报修记录</view><view wx:else class="card" wx:for="{{rows}}" wx:key="id" data-id="{{item.id}}" bindtap="detail"><view class="row"><view class="card-title grow">{{item.title}}</view><view class="status">{{item.statusLabel}}</view></view><view class="card-subtitle">{{item.orderNo}}</view><view class="meta">位置：{{item.location}}</view><view class="meta">维修人员：{{item.technicianName||'等待派单'}}</view></view></view>
